{
    "name": "kukbuk-srv",
    "image": "mcr.microsoft.com/devcontainers/java:1-25-noble",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": true
        },
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "mounts": [
        "source=claude-code-config,target=/home/vscode/.claude,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
        "COOKBOOK_GEMINI_API_KEY": "${localEnv:COOKBOOK_GEMINI_API_KEY}"
    },
    "postCreateCommand": "chmod +x gradlew",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vscjava.vscode-gradle"
            ]
        }
    }
}